---
import Site from '../layouts/Site.astro';
import { products } from '../data/site';
---

<Site
  title="Viber Ops — 自托管运维工具"
  description="Viber Ops 产品与使用文档。Configra 提供应用配置、敏感值和客户端证书管理，支持 Go SDK 与 Kubernetes 接入。"
  section="products"
>
  <main id="main">
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="status-dot" aria-hidden="true"></span> VIBER OPS
          </p>
          <h1>
            研发与运维的
            <br />
            <span>自托管工具。</span>
          </h1>
          <p class="hero-intro">
            Configra 是我们的第一个产品：集中管理应用配置和敏感值，支持 Go SDK 与 Kubernetes 接入。
          </p>
          <div class="actions">
            <a class="button button-light" href="/configra/">
              认识 Configra <span aria-hidden="true">→</span>
            </a>
            <a class="text-link light-link" href="/docs/configra/">
              阅读文档 ↗
            </a>
          </div>
          <div class="hero-note">
            <span>SELF-HOSTED</span>
            <span>GO SDK</span>
            <span>KUBERNETES</span>
          </div>
        </div>
        <div class="hero-product">
          <div class="window-caption">
            <span>
              <span class="mini-mark">c</span> Configra <span class="preview-pill">Preview</span>
            </span>
            <span class="window-label">VAULT WORKSPACE</span>
          </div>
          <a href="/configra/" aria-label="了解 Configra 配置与敏感值管理">
            <img
              src="/assets/configra/vault-light.png"
              alt="Configra 浅色 Vault 界面：左侧资源导航、中央条目列表与右侧字段详情。画面使用演示数据。"
              width="1440"
              height="1000"
              fetchpriority="high"
            />
          </a>
          <div class="product-caption">
            <span>
              <span class="status-dot" aria-hidden="true"></span> Configra Vault 工作台
            </span>
            <span>演示数据</span>
          </div>
        </div>
      </div>
    </section>
    <section id="products" class="section container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">PRODUCTS</p>
          <h2>产品</h2>
        </div>
      </div>
      {products.map((product) => (
        <article class="product-row">
          <div class="product-icon" aria-hidden="true">
            c<span>_</span>
          </div>
          <div class="product-description">
            <p class="eyebrow">{product.category}</p>
            <h3>
              <a href={product.href}>{product.name}</a>
              <span class="tag">{product.status}</span>
            </h3>
            <p>{product.description}</p>
            <div class="inline-tags">
              <span>YAML / JSON</span>
              <span>Vault</span>
              <span>mTLS</span>
              <span>Kubernetes</span>
            </div>
          </div>
          <div class="product-links">
            <a class="button button-primary" href={product.href}>
              查看产品 <span aria-hidden="true">→</span>
            </a>
            <a class="text-link" href="/docs/configra/quickstart/">
              开始本地体验
            </a>
          </div>
        </article>
      ))}
    </section>
    <section class="docs-banner container">
      <div>
        <p class="eyebrow">DOCUMENTATION</p>
        <h2>Configra 使用文档</h2>
        <p>本地启动、应用接入、Kubernetes 部署与备份。</p>
      </div>
      <a class="button button-light" href="/docs/configra/quickstart/">
        查看快速开始 →
      </a>
    </section>
  </main>
</Site>
